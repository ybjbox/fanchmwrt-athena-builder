#!/bin/sh
#
# 99-athena-custom-settings — 首启一次性默认值（uci-defaults 执行后自删）
#
# 占位符 __MY_* 由 CI 在编译期用 Secrets 替换；未配置时保持占位符，
# 下面的 valid() 会把它当作"未设置"，避免把 SSID 写成 __MY_WIFI_SSID_5G__。
#

PPPOE_USER="__MY_PPPOE_USERNAME__"
PPPOE_PASS="__MY_PPPOE_PASSWORD__"
WIFI_2G="__MY_WIFI_SSID_2G__"
WIFI_5G="__MY_WIFI_SSID_5G__"
WIFI_PASS="__MY_WIFI_PASSWORD__"
ADMIN_PASS="__MY_ADMIN_PASSWORD__"

valid() {
  [ -n "$1" ] || return 1
  case "$1" in __MY_*) return 1 ;; esac
  return 0
}

log() { logger -t athena-defaults "$*" 2>/dev/null || true; }

# ── 0. SSID 红线 ──
# SSID 是明文广播的：一旦某个 SSID 变量装的是 WiFi 密码，密码就等于
# 公开贴在空气里。Secret 填错位（把密码粘到 WIFI_SSID_5G 一栏）时症状
# 正是"5G 的信号名是密码，但密码也能连上"。这里不信任输入：
#   - 与密码相同 → 换成回退名，并留一条系统日志
#   - 超过 32 字节 → 截断（hostapd 上限）
# 2026-11-17 交付的那版固件就是靠这条规则才没有继续广播密码。
ssid_guard() { # <SSID> <回退名>
  _v="$1"
  _fb="$2"
  if valid "$WIFI_PASS" && [ "$_v" = "$WIFI_PASS" ]; then
    log "SSID 与 WiFi 密码相同，已回退为 $_fb（密码会随 SSID 明文广播，请检查 Secrets 是否填错位）"
    printf '%s' "$_fb"
    return 0
  fi
  if [ "${#_v}" -gt 32 ]; then
    log "SSID 超过 32 字节，已截断为前 32 字节（原值 ${#_v} 字节）"
    printf '%.32s' "$_v"
    return 0
  fi
  printf '%s' "$_v"
}

SSID_2G=""
SSID_5G=""
valid "$WIFI_2G" && SSID_2G="$(ssid_guard "$WIFI_2G" 'Athena')"
valid "$WIFI_5G" && SSID_5G="$(ssid_guard "$WIFI_5G" 'Athena_5G')"

# ── 1. 主机名 / LAN 地址 ──
uci set system.@system[0].hostname='Athena'
uci set network.lan.ipaddr='10.0.0.1'
uci set network.lan.netmask='255.255.255.0'

# ── 2. PPPoE（凭据齐全才切换，否则保持 DHCP）──
if valid "$PPPOE_USER" && valid "$PPPOE_PASS"; then
  uci set network.wan.proto='pppoe'
  uci set network.wan.username="$PPPOE_USER"
  uci set network.wan.password="$PPPOE_PASS"
  uci -q delete network.wan.ipaddr 2>/dev/null || true
fi

# ── 3. 关闭 IPv6 ──
uci set network.wan6.disabled='1'
uci set network.lan.delegate='0'
uci set network.lan.ipv6='0'
uci set network.wan.ipv6='0'
uci set dhcp.lan.dhcpv6='disabled'
uci -q delete dhcp.lan.ra 2>/dev/null || true
uci -q delete dhcp.lan.dhcpv6 2>/dev/null || true
/etc/init.d/odhcpd disable 2>/dev/null || true

# ── 4. 无线：2.4G 独立 SSID，双 5G 同名实现漫游 ──
# /etc/config/wireless 由 /etc/init.d/boot 里的 `wifi config`（读 board.json）
# 在 uci-defaults 之前生成，正常情况下这里已经有带 band 的 radio 段。
# 兜底写法必须用 `wifi config`：`wifi detect` 在 23.05+ 已废弃，只往 stderr
# 打一行警告就 exit 1，用它做兜底只会留下一个空的 /etc/config/wireless。
if [ ! -s /etc/config/wireless ]; then
  wifi config >/dev/null 2>&1 || true
fi

idx=0
while uci -q get "wireless.@wifi-iface[$idx]" >/dev/null 2>&1; do
  mode=$(uci -q get "wireless.@wifi-iface[$idx].mode")
  dev=$(uci -q get "wireless.@wifi-iface[$idx].device")
  band=$(uci -q get "wireless.$dev.band")
  hw=$(uci -q get "wireless.$dev.hwmode")

  # 只动 AP 接口：sta / 中继 之类的接口不该被改名改密码
  if [ "$mode" = "ap" ] || [ -z "$mode" ]; then
    case "${band:-$hw}" in
      2g|11b|11g)
        [ -n "$SSID_2G" ] && uci set "wireless.@wifi-iface[$idx].ssid=$SSID_2G"
        ;;
      *)
        [ -n "$SSID_5G" ] && uci set "wireless.@wifi-iface[$idx].ssid=$SSID_5G"
        ;;
    esac
    if valid "$WIFI_PASS"; then
      uci set "wireless.@wifi-iface[$idx].encryption=psk2"
      uci set "wireless.@wifi-iface[$idx].key=$WIFI_PASS"
    fi
  fi
  idx=$((idx + 1))
done

radio=0
while uci -q get "wireless.radio$radio" >/dev/null 2>&1; do
  uci set "wireless.radio$radio.disabled=0"
  band=$(uci -q get "wireless.radio$radio.band")
  hw=$(uci -q get "wireless.radio$radio.hwmode")
  case "${band:-$hw}" in
    2g|11b|11g)
      uci set "wireless.radio$radio.channel=11"
      uci set "wireless.radio$radio.htmode=HT20"
      ;;
    *)
      uci set "wireless.radio$radio.channel=auto"
      ;;
  esac
  radio=$((radio + 1))
done

uci commit wireless
wifi reload >/dev/null 2>&1 || true

log "无线已写入：2G=${SSID_2G:-（未设置）} 5G=${SSID_5G:-（未设置）}"

# ── 5. 关闭 Fastnat（流量统计依赖 conntrack，必须保持关闭）──
uci set fastnat.global.enabled='0'
uci set fastnat.global.dpi_compat='1'
uci commit fastnat 2>/dev/null || true

# ── 6. 软件源换国内镜像（FanchmWrt 25.12 用 apk）──
if [ -f /etc/apk/repositories.d/distfeeds.list ]; then
  sed -i 's#https://downloads.openwrt.org#https://mirrors.ustc.edu.cn/openwrt#g' \
    /etc/apk/repositories.d/distfeeds.list 2>/dev/null || true
fi

# ── 7. root 口令 ──
if valid "$ADMIN_PASS"; then
  printf '%s\n%s\n' "$ADMIN_PASS" "$ADMIN_PASS" | passwd root 2>/dev/null || true
fi

# ── 8. 定时重启：不做任何预置 ──
# 改由 ImmortalWrt 的 luci-app-autoreboot 提供（features.md 的 autoreboot 行）。
# 插件默认 enabled=0，刷完不会自动重启；要启用请到网页「系统 → 定时重启」
# 自己开、自己设时间。这里刻意不写 /etc/crontabs/root，避免两套计划重复重启。

# ── 9. 关掉 80 → 443 强制跳转（局域网用 HTTP 直连）──
# 这版固件的 LuCI 跑在 nginx + uwsgi 上，默认把 80 端口交给 _redirect2ssl：
#   访问 http://10.0.0.1 → 302 到 https://10.0.0.1/... → 自签证书警告
# （警告不是故障：证书里没有 IP:10.0.0.1 这个 SAN，导入根证书也消不掉。）
# 局域网自用没必要走 HTTPS：让 _lan 同时监听 80，删掉只做跳转的那个 server。
# 访问 10.0.0.1 仍会 302 到 /cgi-bin/luci/，那是 LuCI 自己的路径补全，属正常。
#
# 两个必须写清的细节：
#   - listen 是列表，必须用 add_list；写成 set 会把 443 那两条覆盖掉，网页直接打不开
#   - nginx-util 的 init_lan 只重建 listen 文件与配置产物，不会把 _redirect2ssl
#     写回 UCI，所以这里的删除是持久的，重启不会复活
# 改完立刻用 nginx -t 校验；不通过就还原，宁可保留跳转也不能让网页打不开。
# 想保留默认的强制跳转：把下面的 ATHENA_NGINX_HTTP_ONLY 设为 0。
NGINX_UCI="${ATHENA_NGINX_UCI:-/etc/config/nginx}"
if [ "${ATHENA_NGINX_HTTP_ONLY:-1}" = "1" ] && [ -f "$NGINX_UCI" ]; then
  cp -f "$NGINX_UCI" "$NGINX_UCI.athena-bak" 2>/dev/null || true

  uci -q delete nginx._redirect2ssl 2>/dev/null || true
  uci -q add_list nginx._lan.listen='80 default_server' 2>/dev/null || true
  # 固件若保留了 IPv6 监听（_lan 里有 [::]:443），80 也补一条保持对称；
  # 没保留就不加，避免在关掉 IPv6 的环境里让 nginx 绑不上 [::] 而起不来。
  # 这里只匹配 `::`：BusyBox 的 BRE 对 `\[` 转义处理有差异，不冒险。
  if uci -q get nginx._lan.listen 2>/dev/null | grep -q '::'; then
    uci -q add_list nginx._lan.listen='[::]:80 default_server' 2>/dev/null || true
  fi
  uci -q commit nginx 2>/dev/null || true

  if [ -x /usr/bin/nginx-util ] && [ -x /usr/sbin/nginx ]; then
    eval "$(/usr/bin/nginx-util get_env 2>/dev/null)" || true
    CONF_TEST="${UCI_CONF:-/etc/nginx/uci.conf}"
    # init_lan 按新的 UCI 重新生成配置并补齐自签证书，再交给 nginx -t 试跑
    if /usr/bin/nginx-util init_lan >/dev/null 2>&1 && [ -e "$CONF_TEST" ]; then
      if /usr/sbin/nginx -t -c "$CONF_TEST" -g 'daemon off;' >/dev/null 2>&1; then
        # 60_nginx-luci-support 在本脚本之前就已经把 nginx 拉起来了，必须重启才生效
        /etc/init.d/nginx restart >/dev/null 2>&1 || true
        log "已关闭 80 → 443 强制跳转：http://10.0.0.1 可直连 LuCI"
      else
        cp -f "$NGINX_UCI.athena-bak" "$NGINX_UCI" 2>/dev/null || true
        uci -q commit nginx 2>/dev/null || true
        /usr/bin/nginx-util init_lan >/dev/null 2>&1 || true
        /etc/init.d/nginx restart >/dev/null 2>&1 || true
        log "nginx 80 端口改动未通过校验，已回滚为 HTTPS 强制跳转"
      fi
    fi
  fi
fi

# ── 10. nginx 重定向改相对路径（反代访问保留 https 与端口）──
# 公网经反代（例如 https://op.403333.xyz:8888/）访问 LuCI，会被 302 到
# http://op.403333.xyz/cgi-bin/luci/：scheme 降成 http、端口 8888 丢失，
# 后台在公网就打不开了。
# 根因在 /etc/nginx/conf.d/luci.locations 的第一条：
#   location = / { return 302 /cgi-bin/luci/; }
# 它写的是相对路径，但 nginx 默认 absolute_redirect on 会补成绝对地址：
#   scheme 取本机这条连接（反代连的是 80 就是 http）
#   端口取 $server_port（nginx 自己监听的端口，不是 Host 头里的端口）
# 所以改 Host 头、加 X-Forwarded-Proto 都救不回来——反代端口一定丢。
# 关掉绝对化后返回相对 Location，浏览器按地址栏 origin 解析，问题消失。
# 局域网 http://10.0.0.1 与 443 直连的表现不变。
# 想保留 nginx 默认行为：把下面的 ATHENA_NGINX_REL_REDIRECT 设为 0。
NGINX_LOC="${ATHENA_NGINX_LOCATIONS:-/etc/nginx/conf.d/luci.locations}"
NGINX_BIN="${ATHENA_NGINX_BIN:-/usr/sbin/nginx}"
if [ "${ATHENA_NGINX_REL_REDIRECT:-1}" = "1" ] && [ -f "$NGINX_LOC" ]; then
  if grep -q 'absolute_redirect' "$NGINX_LOC" 2>/dev/null; then
    log "nginx 相对重定向已设置，跳过"
  elif [ ! -x "$NGINX_BIN" ]; then
    log "未找到 $NGINX_BIN，跳过 nginx 相对重定向设置"
  else
    REL_CONF="${ATHENA_NGINX_CONF:-/etc/nginx/uci.conf}"
    cp -f "$NGINX_LOC" "$NGINX_LOC.athena-bak" 2>/dev/null || true
    # 写临时文件再覆盖回去：不走 mv/rename，避免个别文件系统上的替换异常
    if printf 'absolute_redirect off;\n' > "$NGINX_LOC.athena-new" 2>/dev/null &&
       cat "$NGINX_LOC.athena-bak" >> "$NGINX_LOC.athena-new" 2>/dev/null &&
       cat "$NGINX_LOC.athena-new" > "$NGINX_LOC" 2>/dev/null; then
      rm -f "$NGINX_LOC.athena-new" 2>/dev/null || true
      if "$NGINX_BIN" -t -c "$REL_CONF" -g 'daemon off;' >/dev/null 2>&1; then
        /etc/init.d/nginx restart >/dev/null 2>&1 || true
        log "nginx 重定向已改为相对路径：反代访问可保留 https 与端口"
      else
        cp -f "$NGINX_LOC.athena-bak" "$NGINX_LOC" 2>/dev/null || true
        /etc/init.d/nginx restart >/dev/null 2>&1 || true
        log "nginx 相对重定向改动未通过校验，已回滚"
      fi
    else
      rm -f "$NGINX_LOC.athena-new" 2>/dev/null || true
      log "nginx 相对重定向写入失败，已跳过"
    fi
  fi
fi

# ── 11. 浏览器标签标题跟随主机名 ──
# luci-theme-fanchmwrt 把 <title>FanchmWrt</title> 写死在 header.ut 里，
# 第 1 段改了 hostname 也不会让标签变——标签跟 hostname 是两回事。
# 换成读 boardinfo.hostname 后，标签就跟着「系统 → 主机名」走（默认 Athena）；
# 以后在网页里改主机名，标签也会同步。主题升级若覆盖该文件，重刷首启会再修一次。
# 想保留原样：把下面的 ATHENA_LUCI_TITLE_HOSTNAME 设为 0。
LUCI_HEADER="${ATHENA_LUCI_HEADER:-/usr/share/ucode/luci/template/themes/fanchmwrt/header.ut}"
if [ "${ATHENA_LUCI_TITLE_HOSTNAME:-1}" = "1" ] && [ -f "$LUCI_HEADER" ]; then
  if [ "$(head -c 1 "$LUCI_HEADER" 2>/dev/null)" != "<" ]; then
    # CONFIG_LUCI_UTMIN=y 的固件里，*.ut 已被 ucode -c 预编译成字节码，
    # 在里面替换字符串会破坏长度字段、把模板弄坏。这类固件由编译期
    # sed 源码解决（见 .github/workflows/build.yml 的「改标签标题」步骤）。
    log "header.ut 是预编译字节码，跳过运行时改标签标题"
  elif grep -q "boardinfo.hostname ?? 'Athena'" "$LUCI_HEADER" 2>/dev/null; then
    :
  elif grep -q '<title>FanchmWrt</title>' "$LUCI_HEADER" 2>/dev/null; then
    cp -f "$LUCI_HEADER" "$LUCI_HEADER.athena-bak" 2>/dev/null || true
    if sed -i "s|<title>FanchmWrt</title>|<title>{{ striptags(boardinfo.hostname ?? 'Athena') }}</title>|" \
         "$LUCI_HEADER" 2>/dev/null; then
      # 模板有编译缓存，重启 uwsgi 让新标题立刻生效
      /etc/init.d/uwsgi restart >/dev/null 2>&1 || true
      log "浏览器标签标题已改为跟随主机名"
    else
      cp -f "$LUCI_HEADER.athena-bak" "$LUCI_HEADER" 2>/dev/null || true
      log "浏览器标签标题改动失败，已回滚"
    fi
  fi
fi

uci commit network
uci commit dhcp
uci commit system
uci commit luci 2>/dev/null || true

exit 0
