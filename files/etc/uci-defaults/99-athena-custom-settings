#!/bin/sh
#
# 99-athena-custom-settings — 首启一次性默认值（uci-defaults 执行后自删）
#
# 占位符 __MY_* 由 CI 在编译期用 Secrets 替换；未配置时保持占位符，
# 下面的 valid() 会把它当作"未设置"，避免把 SSID 写成 __MY_WIFI_SSID_5G__。
#

PPPOE_USER="__MY_PPPOE_USERNAME__"
PPPOE_PASS="__MY_PPPOE_PASSWORD__"
WIFI_2G="__MY_WIFI_SSID_2G__"
WIFI_5G="__MY_WIFI_SSID_5G__"
WIFI_PASS="__MY_WIFI_PASSWORD__"
ADMIN_PASS="__MY_ADMIN_PASSWORD__"

valid() {
  [ -n "$1" ] || return 1
  case "$1" in __MY_*) return 1 ;; esac
  return 0
}

log() { logger -t athena-defaults "$*" 2>/dev/null || true; }

# ── 0. SSID 红线 ──
# SSID 是明文广播的：一旦某个 SSID 变量装的是 WiFi 密码，密码就等于
# 公开贴在空气里。Secret 填错位（把密码粘到 WIFI_SSID_5G 一栏）时症状
# 正是"5G 的信号名是密码，但密码也能连上"。这里不信任输入：
#   - 与密码相同 → 换成回退名，并留一条系统日志
#   - 超过 32 字节 → 截断（hostapd 上限）
# 2026-11-17 交付的那版固件就是靠这条规则才没有继续广播密码。
ssid_guard() { # <SSID> <回退名>
  _v="$1"
  _fb="$2"
  if valid "$WIFI_PASS" && [ "$_v" = "$WIFI_PASS" ]; then
    log "SSID 与 WiFi 密码相同，已回退为 $_fb（密码会随 SSID 明文广播，请检查 Secrets 是否填错位）"
    printf '%s' "$_fb"
    return 0
  fi
  if [ "${#_v}" -gt 32 ]; then
    log "SSID 超过 32 字节，已截断为前 32 字节（原值 ${#_v} 字节）"
    printf '%.32s' "$_v"
    return 0
  fi
  printf '%s' "$_v"
}

SSID_2G=""
SSID_5G=""
valid "$WIFI_2G" && SSID_2G="$(ssid_guard "$WIFI_2G" 'Athena')"
valid "$WIFI_5G" && SSID_5G="$(ssid_guard "$WIFI_5G" 'Athena_5G')"

# ── 1. 主机名 / LAN 地址 ──
uci set system.@system[0].hostname='Athena'
uci set network.lan.ipaddr='10.0.0.1'
uci set network.lan.netmask='255.255.255.0'

# ── 2. PPPoE（凭据齐全才切换，否则保持 DHCP）──
if valid "$PPPOE_USER" && valid "$PPPOE_PASS"; then
  uci set network.wan.proto='pppoe'
  uci set network.wan.username="$PPPOE_USER"
  uci set network.wan.password="$PPPOE_PASS"
  uci -q delete network.wan.ipaddr 2>/dev/null || true
fi

# ── 3. 关闭 IPv6 ──
uci set network.wan6.disabled='1'
uci set network.lan.delegate='0'
uci set network.lan.ipv6='0'
uci set network.wan.ipv6='0'
uci set dhcp.lan.dhcpv6='disabled'
uci -q delete dhcp.lan.ra 2>/dev/null || true
uci -q delete dhcp.lan.dhcpv6 2>/dev/null || true
/etc/init.d/odhcpd disable 2>/dev/null || true

# ── 4. 无线：2.4G 独立 SSID，双 5G 同名实现漫游 ──
# /etc/config/wireless 由 /etc/init.d/boot 里的 `wifi config`（读 board.json）
# 在 uci-defaults 之前生成，正常情况下这里已经有带 band 的 radio 段。
# 兜底写法必须用 `wifi config`：`wifi detect` 在 23.05+ 已废弃，只往 stderr
# 打一行警告就 exit 1，用它做兜底只会留下一个空的 /etc/config/wireless。
if [ ! -s /etc/config/wireless ]; then
  wifi config >/dev/null 2>&1 || true
fi

idx=0
while uci -q get "wireless.@wifi-iface[$idx]" >/dev/null 2>&1; do
  mode=$(uci -q get "wireless.@wifi-iface[$idx].mode")
  dev=$(uci -q get "wireless.@wifi-iface[$idx].device")
  band=$(uci -q get "wireless.$dev.band")
  hw=$(uci -q get "wireless.$dev.hwmode")

  # 只动 AP 接口：sta / 中继 之类的接口不该被改名改密码
  if [ "$mode" = "ap" ] || [ -z "$mode" ]; then
    case "${band:-$hw}" in
      2g|11b|11g)
        [ -n "$SSID_2G" ] && uci set "wireless.@wifi-iface[$idx].ssid=$SSID_2G"
        ;;
      *)
        [ -n "$SSID_5G" ] && uci set "wireless.@wifi-iface[$idx].ssid=$SSID_5G"
        ;;
    esac
    if valid "$WIFI_PASS"; then
      uci set "wireless.@wifi-iface[$idx].encryption=psk2"
      uci set "wireless.@wifi-iface[$idx].key=$WIFI_PASS"
    fi
  fi
  idx=$((idx + 1))
done

radio=0
while uci -q get "wireless.radio$radio" >/dev/null 2>&1; do
  uci set "wireless.radio$radio.disabled=0"
  band=$(uci -q get "wireless.radio$radio.band")
  hw=$(uci -q get "wireless.radio$radio.hwmode")
  case "${band:-$hw}" in
    2g|11b|11g)
      uci set "wireless.radio$radio.channel=11"
      uci set "wireless.radio$radio.htmode=HT20"
      ;;
    *)
      uci set "wireless.radio$radio.channel=auto"
      ;;
  esac
  radio=$((radio + 1))
done

uci commit wireless
wifi reload >/dev/null 2>&1 || true

log "无线已写入：2G=${SSID_2G:-（未设置）} 5G=${SSID_5G:-（未设置）}"

# ── 5. 关闭 Fastnat（流量统计依赖 conntrack，必须保持关闭）──
uci set fastnat.global.enabled='0'
uci set fastnat.global.dpi_compat='1'
uci commit fastnat 2>/dev/null || true

# ── 6. 软件源换国内镜像（FanchmWrt 25.12 用 apk）──
if [ -f /etc/apk/repositories.d/distfeeds.list ]; then
  sed -i 's#https://downloads.openwrt.org#https://mirrors.ustc.edu.cn/openwrt#g' \
    /etc/apk/repositories.d/distfeeds.list 2>/dev/null || true
fi

# ── 7. root 口令 ──
if valid "$ADMIN_PASS"; then
  printf '%s\n%s\n' "$ADMIN_PASS" "$ADMIN_PASS" | passwd root 2>/dev/null || true
fi

# ── 8. 定时重启：不做任何预置 ──
# 改由 ImmortalWrt 的 luci-app-autoreboot 提供（features.md 的 autoreboot 行）。
# 插件默认 enabled=0，刷完不会自动重启；要启用请到网页「系统 → 定时重启」
# 自己开、自己设时间。这里刻意不写 /etc/crontabs/root，避免两套计划重复重启。

uci commit network
uci commit dhcp
uci commit system
uci commit luci 2>/dev/null || true

exit 0
